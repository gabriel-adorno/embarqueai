# Copie para .env.local. Sem EXPO_PUBLIC_API_URL o app usa o mock local.

# Produção:
EXPO_PUBLIC_API_URL=https://embarqueai-api.gabrielviniciusadorno.workers.dev
# Local: http://localhost:8787  (Android emulador: http://10.0.2.2:8787)

# Maps SDK (iOS/Android). Não use a chave de servidor aqui.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
